{
  "name": "gpu-bench",
  "productName": "GPU Bench",
  "version": "0.1.0",
  "description": "Misura le prestazioni della tua GPU con l'inferenza LLM (llama.cpp, vLLM).",
  "author": "GPU Bench",
  "desktopName": "gpu-bench.desktop",
  "homepage": "https://gpu-bench.invalid",
  "license": "MIT",
  "private": true,
  "main": "out/main/index.cjs",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:watch": "node scripts/build.mjs --watch",
    "start": "electron .",
    "dev": "node scripts/build.mjs && electron .",
    "core": "node out/core/index.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:real": "playwright test --config playwright.real.config.ts",
    "coverage": "node scripts/coverage.mjs",
    "validate": "node scripts/validate.mjs",
    "dist": "node scripts/build.mjs --production && electron-builder"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@hono/node-server": "^2.1.3",
    "@huggingface/gguf": "^0.4.6",
    "@huggingface/hub": "^2.17.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-table": "^9.2.6",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dependency-cruiser": "^18.5.0",
    "echarts": "^6.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eventsource-parser": "^4.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "hono": "^4.13.13",
    "lucide-react": "^1.52.0",
    "monocart-coverage-reports": "^2.13.1",
    "motion": "^14.0.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tar": "^7.5.22",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "yauzl": "^3.4.0",
    "zod": "^4.6.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true,
    "electron@44.5.1": true
  }
}
